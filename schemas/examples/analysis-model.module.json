{
  "schemaVersion": "1.0",
  "id": "org.eclipsehealth.cardia",
  "name": "Cardia 2.0",
  "description": "Beat classification and ECG measurements powered by Cardia 2.0.",
  "version": "2.0.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "analysis-model",
  "author": { "name": "eclipse health" },
  "license": "GPL-3.0-only",
  "permissions": ["records:read"],
  "entry": { "python": "src/module.py", "factory": "create_module" },
  "contributes": {
    "models": [
      {
        "id": "cardia-2.0",
        "name": "Cardia 2.0",
        "task": "beat-classification",
        "format": "onnx",
        "files": [
          {
            "path": "models/cardia_k4_best.onnx",
            "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          }
        ],
        "input": { "leads": ["MLII"], "fs": 360, "windowSamples": 180, "features": "cardia-104d" },
        "output": { "classes": ["N", "SVEB", "VEB", "F"] },
        "preprocess": { "pipeline": "cardia-v2", "version": "2.0" },
        "runtime": { "device": "cpu", "memoryMb": 512 },
        "modelCard": {
          "trainingData": "MIT-BIH Arrhythmia",
          "metrics": { "composite": 74.0 },
          "limitations": ["MLII only", "360 Hz only"],
          "license": "GPL-3.0-only",
          "nonDiagnostic": true
        }
      }
    ]
  },
  "resources": { "memoryMb": 768, "cpu": 2, "startupTimeoutMs": 15000 },
  "updateChannel": "stable"
}
