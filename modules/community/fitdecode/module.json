{
  "schemaVersion": "1.0",
  "id": "io.github.polyvertex.fitdecode",
  "name": "FIT Decoder",
  "description": "适配自 polyvertex/fitdecode：解码 Garmin/ANT .FIT 活动文件，输出活动会话、距离与心率摘要。非医疗器械，不用于诊断。",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "device-adapter",
  "author": { "name": "polyvertex + eclipse health adapters", "url": "https://github.com/polyvertex/fitdecode" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/polyvertex/fitdecode",
  "dependencies": ["fitdecode>=0.10,<1"],
  "permissions": ["files:user-selected", "records:write"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "importFormats": [
      {
        "id": "fit",
        "ext": ["fit"],
        "label": "Garmin/ANT FIT",
        "description": "Garmin、Wahoo 等设备导出的 .FIT 活动文件。"
      }
    ],
    "recordTypes": [
      {
        "id": "activity.session",
        "name": "Activity session",
        "schema": {
          "type": "object",
          "required": ["startedAt", "durationSeconds"],
          "properties": {
            "startedAt": { "type": ["string", "null"] },
            "endedAt": { "type": ["string", "null"] },
            "durationSeconds": { "type": ["number", "null"] },
            "distanceKm": { "type": ["number", "null"] },
            "avgHeartRate": { "type": ["number", "null"] },
            "maxHeartRate": { "type": ["number", "null"] },
            "source": { "type": "string" },
            "nonDiagnostic": { "type": "string" }
          }
        },
        "indexes": ["startedAt"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "fit-distance",
          "title": "最近 FIT 距离",
          "description": "最近一次 FIT 导入的距离",
          "size": "md",
          "dataSource": { "type": "module-rpc", "method": "latestSummary" },
          "view": { "type": "stat", "valuePath": "distanceKm", "unit": "km", "label": "距离" }
        }
      ]
    }
  },
  "resources": { "memoryMb": 128, "cpu": 0.5, "startupTimeoutMs": 8000 },
  "updateChannel": "stable"
}
