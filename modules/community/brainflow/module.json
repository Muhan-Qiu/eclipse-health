{
  "schemaVersion": "1.0",
  "id": "io.github.brainflow-dev.brainflow",
  "name": "BrainFlow EEG/EMG Capture",
  "description": "Adapted from https://github.com/brainflow-dev/brainflow. Streams EEG/EMG/ECG from supported boards, summarises signal quality, and imports recorded JSONL. Requires compatible hardware; non-medical, not for diagnosis.",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "device-adapter",
  "author": { "name": "Andrey Parfenov / BrainFlow contributors & eclipse health adapters", "url": "https://github.com/brainflow-dev/brainflow" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/brainflow-dev/brainflow",
  "permissions": ["files:user-selected", "records:write"],
  "dependencies": ["brainflow>=5.13,<6"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "importFormats": [
      {
        "id": "brainflow-jsonl",
        "ext": ["jsonl", "json"],
        "label": "BrainFlow JSONL recording",
        "description": "One JSON object per line with board, sampleRate and per-channel samples."
      }
    ],
    "recordTypes": [
      {
        "id": "eeg.session",
        "name": "EEG session",
        "schema": {
          "type": "object",
          "required": ["capturedAt", "board", "sampleRate", "channelCount", "source"],
          "properties": {
            "capturedAt": { "type": "string" },
            "board": { "type": "string" },
            "sampleRate": { "type": "number", "exclusiveMinimum": 0 },
            "channelCount": { "type": "integer", "minimum": 1 },
            "durationSeconds": { "type": "number", "minimum": 0 },
            "quality": { "type": "number", "minimum": 0, "maximum": 100 },
            "source": { "type": "string" }
          }
        },
        "indexes": ["capturedAt"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "brainflow-quality",
          "title": "EEG 信号质量",
          "description": "最近一次采集的通道平均质量",
          "size": "md",
          "dataSource": { "type": "module-rpc", "method": "stats", "params": {} },
          "view": { "type": "progress", "valuePath": "latest.quality", "min": 0, "max": 100, "unit": "%" }
        }
      ],
      "pages": [
        {
          "id": "brainflow-channels",
          "title": "EEG 通道",
          "icon": "activity",
          "layout": [
            {
              "component": "text",
              "text": "非医疗器械，不用于诊断。原始脑电隐私极高，默认仅在本机处理，不写入日志。"
            },
            {
              "component": "table",
              "title": "通道质量",
              "source": { "type": "module-rpc", "method": "channels.list" },
              "rowPath": "items",
              "columns": [
                { "key": "name", "label": "通道" },
                { "key": "quality", "label": "质量", "unit": "%", "format": "number" },
                { "key": "rms", "label": "RMS", "unit": "uV", "format": "number" }
              ]
            }
          ]
        }
      ]
    }
  },
  "resources": { "memoryMb": 512, "cpu": 1, "startupTimeoutMs": 15000 },
  "updateChannel": "stable"
}
