{
  "schemaVersion": "1.0",
  "id": "io.github.gagebenne.pydexcom",
  "name": "Dexcom CGM",
  "description": "适配自 gagebenne/pydexcom：通过 Dexcom Share 读取本人 CGM 血糖读数并计算时间范围内占比。非医疗器械，不用于诊断。",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "device-adapter",
  "author": { "name": "Gage Benne + eclipse health adapters", "url": "https://github.com/gagebenne/pydexcom" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/gagebenne/pydexcom",
  "dependencies": ["pydexcom>=0.4,<1"],
  "permissions": ["network", "records:write"],
  "allowedHosts": ["share2.dexcom.com", "shareous1.dexcom.com"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "importFormats": [
      {
        "id": "dexcom-share",
        "ext": ["json"],
        "label": "Dexcom Share 导出 JSON",
        "description": "离线回放的结构化血糖读数；字段见 README。"
      }
    ],
    "recordTypes": [
      {
        "id": "glucose.reading",
        "name": "Glucose reading",
        "schema": {
          "type": "object",
          "required": ["valueMgdl", "measuredAt"],
          "properties": {
            "valueMgdl": { "type": "number", "minimum": 10, "maximum": 800 },
            "valueMmol": { "type": "number" },
            "trend": { "type": ["integer", "string", "null"] },
            "trendText": { "type": "string" },
            "measuredAt": { "type": "string" },
            "source": { "type": "string" },
            "nonDiagnostic": { "type": "string" }
          }
        },
        "indexes": ["measuredAt"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "glucose-latest",
          "title": "最近血糖",
          "description": "最近一次 Dexcom 血糖读数",
          "size": "sm",
          "dataSource": { "type": "module-rpc", "method": "latestReading" },
          "view": { "type": "stat", "valuePath": "valueMgdl", "unit": "mg/dL", "label": "血糖" }
        }
      ]
    }
  },
  "resources": { "memoryMb": 128, "cpu": 0.5, "startupTimeoutMs": 8000 },
  "updateChannel": "stable"
}
