{
  "schemaVersion": "1.0",
  "id": "io.github.dtcooper.fitparse",
  "name": "FIT Parser",
  "description": "适配自 dtcooper/python-fitparse：解析 .FIT 文件的 record 与 lap 摘要，提供活动时长、距离与心率。非医疗器械，不用于诊断。",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "device-adapter",
  "author": { "name": "dtcooper + eclipse health adapters", "url": "https://github.com/dtcooper/python-fitparse" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/dtcooper/python-fitparse",
  "dependencies": ["fitparse>=1.2,<2"],
  "permissions": ["files:user-selected", "records:write"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "importFormats": [
      {
        "id": "fit",
        "ext": ["fit"],
        "label": "Garmin/ANT FIT（fitparse）",
        "description": "使用 python-fitparse 解析的 .FIT 活动文件。"
      }
    ],
    "recordTypes": [
      {
        "id": "activity.session",
        "name": "Activity session",
        "schema": {
          "type": "object",
          "required": ["startedAt", "durationSeconds"],
          "properties": {
            "startedAt": { "type": ["string", "null"] },
            "endedAt": { "type": ["string", "null"] },
            "durationSeconds": { "type": ["number", "null"] },
            "distanceKm": { "type": ["number", "null"] },
            "avgHeartRate": { "type": ["number", "null"] },
            "maxHeartRate": { "type": ["number", "null"] },
            "source": { "type": "string" },
            "nonDiagnostic": { "type": "string" }
          }
        },
        "indexes": ["startedAt"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "fit-avg-hr",
          "title": "最近 FIT 平均心率",
          "description": "最近一次 FIT 导入的平均心率",
          "size": "sm",
          "dataSource": { "type": "module-rpc", "method": "latestSummary" },
          "view": { "type": "stat", "valuePath": "avgHeartRate", "unit": "bpm", "label": "平均心率" }
        }
      ]
    }
  },
  "resources": { "memoryMb": 128, "cpu": 0.5, "startupTimeoutMs": 8000 },
  "updateChannel": "stable"
}
