{
  "schemaVersion": "1.0",
  "id": "io.github.alexandrebarachant.muselsl",
  "name": "Muse LSL Stream",
  "description": "Adapted from https://github.com/alexandrebarachant/muse-lsl. Streams Muse headband EEG over LSL and imports MuseLSL CSV recordings. Requires a Muse headband and Bluetooth; non-medical, not for diagnosis.",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "device-adapter",
  "author": { "name": "Alexandre Barachant & eclipse health adapters", "url": "https://github.com/alexandrebarachant/muse-lsl" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/alexandrebarachant/muse-lsl",
  "permissions": ["files:user-selected", "records:write"],
  "dependencies": ["muselsl>=2.2,<3", "pylsl>=1.16,<2", "bleak>=0.21,<1"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "importFormats": [
      {
        "id": "muselsl-csv",
        "ext": ["csv"],
        "label": "MuseLSL EEG CSV",
        "description": "CSV written by 'muselsl record' (timestamps plus TP9/AF7/AF8/TP10)."
      }
    ],
    "recordTypes": [
      {
        "id": "eeg.session",
        "name": "EEG session",
        "schema": {
          "type": "object",
          "required": ["capturedAt", "preset", "sampleRate", "channelCount", "source"],
          "properties": {
            "capturedAt": { "type": "string" },
            "preset": { "type": "string" },
            "sampleRate": { "type": "number", "exclusiveMinimum": 0 },
            "channelCount": { "type": "integer", "minimum": 1 },
            "durationSeconds": { "type": "number", "minimum": 0 },
            "durationMinutes": { "type": "number", "minimum": 0 },
            "quality": { "type": "number", "minimum": 0, "maximum": 100 },
            "source": { "type": "string" }
          }
        },
        "indexes": ["capturedAt"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "muse-duration",
          "title": "Muse 记录时长",
          "description": "最近一次 Muse EEG 记录时长",
          "size": "md",
          "dataSource": { "type": "module-rpc", "method": "stats", "params": {} },
          "view": { "type": "stat", "valuePath": "latest.durationMinutes", "unit": "min" }
        }
      ],
      "pages": [
        {
          "id": "muse-channels",
          "title": "Muse 通道",
          "icon": "activity",
          "layout": [
            {
              "component": "text",
              "text": "非医疗器械，不用于诊断。脑电数据隐私极高，默认只在本机处理。"
            },
            {
              "component": "table",
              "title": "通道质量",
              "source": { "type": "module-rpc", "method": "channels.list" },
              "rowPath": "items",
              "columns": [
                { "key": "name", "label": "通道" },
                { "key": "quality", "label": "质量", "unit": "%", "format": "number" }
              ]
            }
          ]
        }
      ]
    }
  },
  "resources": { "memoryMb": 256, "cpu": 0.5, "startupTimeoutMs": 15000 },
  "updateChannel": "stable"
}
