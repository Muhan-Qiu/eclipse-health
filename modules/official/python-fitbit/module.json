{
  "schemaVersion": "1.0",
  "id": "io.github.orcasgit.fitbit",
  "name": "Fitbit Data Sync",
  "description": "Adapted from https://github.com/orcasgit/python-fitbit. Imports Fitbit Web API activity, sleep, heart-rate and weight data into eclipse health. Non-medical; not for diagnosis.",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "data-source",
  "author": { "name": "ORCAS, Inc. & eclipse health adapters", "url": "https://github.com/orcasgit/python-fitbit" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/orcasgit/python-fitbit",
  "permissions": ["network", "records:write"],
  "allowedHosts": ["api.fitbit.com", "www.fitbit.com"],
  "dependencies": ["fitbit>=0.3.1,<0.4", "requests>=2.31,<3", "requests-oauthlib>=1.3,<2"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "sources": [
      {
        "id": "fitbit-web-api",
        "name": "Fitbit Web API",
        "description": "OAuth2 read access to the user's own Fitbit activity, sleep, heart rate and weight data."
      }
    ],
    "recordTypes": [
      {
        "id": "activity.session",
        "name": "Activity session",
        "schema": {
          "type": "object",
          "required": ["capturedAt", "source"],
          "properties": {
            "capturedAt": { "type": "string" },
            "steps": { "type": "integer", "minimum": 0 },
            "caloriesOut": { "type": "number", "minimum": 0 },
            "activeMinutes": { "type": "integer", "minimum": 0 },
            "source": { "type": "string" }
          }
        },
        "indexes": ["capturedAt"]
      },
      {
        "id": "sleep.session",
        "name": "Sleep session",
        "schema": {
          "type": "object",
          "required": ["capturedAt", "source"],
          "properties": {
            "capturedAt": { "type": "string" },
            "minutesAsleep": { "type": "integer", "minimum": 0 },
            "minutesInBed": { "type": "integer", "minimum": 0 },
            "efficiency": { "type": "number", "minimum": 0, "maximum": 100 },
            "source": { "type": "string" }
          }
        },
        "indexes": ["capturedAt"]
      },
      {
        "id": "body.measurement",
        "name": "Body measurement",
        "schema": {
          "type": "object",
          "required": ["capturedAt", "weightKg", "source"],
          "properties": {
            "capturedAt": { "type": "string" },
            "weightKg": { "type": "number", "exclusiveMinimum": 0 },
            "bmi": { "type": "number", "exclusiveMinimum": 0 },
            "source": { "type": "string" }
          }
        },
        "indexes": ["capturedAt"]
      },
      {
        "id": "hr.sample",
        "name": "Heart-rate sample",
        "schema": {
          "type": "object",
          "required": ["capturedAt", "bpm", "source"],
          "properties": {
            "capturedAt": { "type": "string" },
            "bpm": { "type": "integer", "minimum": 1 },
            "source": { "type": "string" }
          }
        },
        "indexes": ["capturedAt"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "fitbit-steps",
          "title": "Fitbit 步数",
          "description": "最近一次已同步的 Fitbit 步数",
          "size": "md",
          "dataSource": { "type": "module-rpc", "method": "stats", "params": { "days": 7 } },
          "view": { "type": "list", "valuePath": "series", "label": "每日步数" }
        }
      ],
      "pages": [
        {
          "id": "fitbit-activity",
          "title": "Fitbit 活动",
          "icon": "activity",
          "layout": [
            {
              "component": "text",
              "text": "非医疗器械，不用于诊断。数据来自用户本人的 Fitbit 账户，仅在本机处理。"
            },
            {
              "component": "table",
              "title": "最近活动",
              "source": { "type": "module-rpc", "method": "activity.list" },
              "rowPath": "items",
              "columns": [
                { "key": "capturedAt", "label": "日期", "format": "date" },
                { "key": "steps", "label": "步数", "format": "number" },
                { "key": "caloriesOut", "label": "消耗", "unit": "kcal", "format": "number" }
              ]
            }
          ]
        }
      ]
    }
  },
  "resources": { "memoryMb": 256, "cpu": 0.5, "startupTimeoutMs": 10000 },
  "updateChannel": "stable"
}
