{
  "schemaVersion": "1.0",
  "id": "org.eclipsehealth.relay-sleep",
  "name": "睡眠分期分析",
  "description": "把整夜睡眠逐窗分成清醒（W）、N1、N2、N3 与快速眼动（REM）五个阶段，输出每段标签、各阶段时长与占比，并给出睡眠结构摘要。支持已提取的 272 维 EEG 特征或原始 30 秒窗口，内置 5 个分期模型可切换对照。非医疗器械，不用于诊断，适合科研、教学与模型比较。",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": {
    "eclipse": ">=1.0 <2.0"
  },
  "type": "analysis-model",
  "author": {
    "name": "eclipse health"
  },
  "license": "GPL-3.0-only",
  "permissions": [
    "records:read"
  ],
  "dependencies": [
    "numpy>=1.26,<3",
    "onnxruntime>=1.17,<2"
  ],
  "entry": {
    "python": "src/main.py",
    "factory": "create_module"
  },
