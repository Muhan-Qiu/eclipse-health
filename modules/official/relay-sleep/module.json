              "shape": [
                10,
                272
              ]
            },
            "dt": {
              "dtype": "float32",
              "shape": [
                10,
                1
              ]
            }
          }
        },
        "output": {
          "classes": [
            "W",
            "N1",
            "N2",
            "N3",
            "R"
          ],
          "tensor": "logits",
          "shape": [
            10,
            5
          ]
        },
        "preprocess": {
          "pipeline": "sleep-edf-272d-chambon-frozen-v1",
          "seqLen": 10,
          "note": "输入为已缓存的 272 维冻结特征；本模块不做 EDF 解码"
        },
        "runtime": {
          "format": "onnx",
          "device": "cpu",
          "memoryMb": 512
        },
        "modelCard": {
          "source": "relay",
          "class": "ours",
          "score": 0.8139,
          "metric": "balanced_accuracy",
          "seqLen": 10,
          "classes": [
            "W",
            "N1",
            "N2",
            "N3",
            "R"
          ],
          "parameters": 2973237,
          "trainingData": "Sleep-EDF (sleep-cassette), 78 subjects, subject-level 60/9/9 split",
          "evaluation": "onnxruntime vs PyTorch argmax agreement 1.0 (see models/verify.json); balanced accuracy 0.8139",
          "limitations": [
            "Research/education use only; not a medical device",
            "Trained and evaluated on Sleep-EDF sleep-cassette",
            "Input must follow the declared tensor layout"
          ],
          "license": "GPL-3.0-only (module code); weights trained by the project owner",
          "nonDiagnostic": true
