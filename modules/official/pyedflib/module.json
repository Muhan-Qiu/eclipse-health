{
  "schemaVersion": "1.0",
  "id": "io.github.holgern.pyedflib",
  "name": "pyedflib · EDF/BDF 读写",
  "description": "适配自 https://github.com/holgern/pyedflib：导出 EDF+ 文件、读取 EDF/BDF 通道，并提供 CSV 导出。非医疗器械，不用于诊断。",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "exporter",
  "author": { "name": "Holger Nahrstaedt + eclipse health adapters", "url": "https://github.com/holgern/pyedflib" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/holgern/pyedflib",
  "permissions": ["files:user-selected", "files:export", "records:read"],
  "dependencies": ["pyedflib>=0.1.38,<1"],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "importFormats": [
      {
        "id": "edf-bdf",
        "ext": ["edf", "bdf"],
        "label": "EDF/BDF 记录",
        "description": "欧洲数据格式 EDF/EDF+/BDF，常见于医院多导睡眠与 EEG 设备。"
      }
    ],
    "exporters": [
      {
        "id": "edf-csv",
        "name": "EDF/BDF 通道 CSV",
        "format": "csv",
        "description": "把 EDF/BDF 记录或多通道信号导出为 CSV；原生 EDF+ 导出通过 RPC export.edf 完成。"
      }
    ]
  },
  "resources": { "memoryMb": 256, "cpu": 0.5, "startupTimeoutMs": 15000 },
  "updateChannel": "stable"
}
