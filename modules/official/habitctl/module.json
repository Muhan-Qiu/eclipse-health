{
  "schemaVersion": "1.0",
  "id": "io.github.blinry.habitctl",
  "name": "habitctl · 习惯追踪",
  "description": "适配自 https://github.com/blinry/habitctl 的极简习惯追踪：通过子进程调用 habitctl CLI，解析每日打卡与连续天数。非医疗器械，不用于诊断。",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "engines": { "eclipse": ">=1.0 <2.0" },
  "type": "health-domain",
  "author": { "name": "blinry + eclipse health adapters", "url": "https://github.com/blinry/habitctl" },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/blinry/habitctl",
  "permissions": ["records:read", "records:write"],
  "dependencies": [],
  "entry": { "python": "src/main.py", "factory": "create_module" },
  "contributes": {
    "recordTypes": [
      {
        "id": "habit.log",
        "name": "Habit log",
        "schema": {
          "type": "object",
          "required": ["habit", "date", "done"],
          "properties": {
            "habit": { "type": "string", "maxLength": 80 },
            "date": { "type": "string", "format": "date" },
            "done": { "type": "boolean" },
            "note": { "type": "string", "maxLength": 500 }
          },
          "additionalProperties": false
        },
        "indexes": ["date", "habit"]
      }
    ],
    "ui": {
      "widgets": [
        {
          "id": "habit-streak",
          "title": "最长连续打卡",
          "description": "当前所有习惯中的最长连续天数",
          "size": "sm",
          "dataSource": { "type": "module-rpc", "method": "habits.summary" },
          "view": { "type": "stat", "unit": "d", "valuePath": "bestStreak" },
          "link": "/modules/io.github.blinry.habitctl/pages/habits"
        }
      ],
      "pages": [
        {
          "id": "habits",
          "title": "习惯",
          "icon": "list-checks",
          "layout": [
            { "component": "text", "text": "非医疗器械，仅用于自我管理，不用于诊断。" },
            {
              "component": "list",
              "title": "今日习惯",
              "source": { "type": "module-rpc", "method": "habits.list" },
              "itemPath": "habits",
              "primaryPath": "name",
              "secondaryPath": "streakText"
            },
            {
              "component": "form",
              "title": "记录打卡",
              "source": { "type": "module-rpc", "method": "habits.form" },
              "submitMethod": "habits.log",
              "fields": [
                { "key": "name", "label": "习惯", "type": "text", "required": true },
                { "key": "date", "label": "日期", "type": "date", "required": true },
                { "key": "done", "label": "已完成", "type": "checkbox", "default": true },
                { "key": "note", "label": "备注", "type": "textarea" }
              ]
            }
          ]
        }
      ]
    }
  },
  "resources": { "memoryMb": 64, "cpu": 0.25, "startupTimeoutMs": 5000 },
  "updateChannel": "stable"
}
